# ==============================================================================
# DHRUVA.AI — STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
ENVIRONMENT=staging
DEBUG=false
PROJECT_NAME="Dhruva.AI Staging Platform"
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

SECRET_KEY=REPLACE_WITH_STAGING_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

COOKIE_NAME_REFRESH_TOKEN=dhruva_staging_refresh_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.staging.dhruva.edu.in

DATABASE_URL=postgresql+asyncpg://dhruva_stage_user:CHANGE_ME_STAGE_PW@staging-db.internal:5432/dhruva_staging_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=15
DATABASE_POOL_TIMEOUT=30

REDIS_URL=redis://staging-redis.internal:6379/0
REDIS_ENABLED=true
REDIS_TIMEOUT_SECONDS=2

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage/uploads_staging

EMAIL_PROVIDER=development
EMAIL_FROM="Dhruva Staging <noreply@staging.dhruva.edu.in>"

GEMINI_API_KEY=AIzaSy_STAGING_KEY_CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
AI_REQUEST_TIMEOUT=30
AI_DAILY_USER_LIMIT=50
AI_DAILY_INSTITUTION_LIMIT=5000

CORS_ORIGINS=["https://staging.dhruva.edu.in"]
FRONTEND_URL=https://staging.dhruva.edu.in

FEATURE_AI_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_BACKGROUND_WORKERS_ENABLED=true
FEATURE_PUBLIC_PORTFOLIOS_ENABLED=true
FEATURE_PLACEMENT_MODULE_ENABLED=true
FEATURE_ADVANCED_ANALYTICS_ENABLED=true
