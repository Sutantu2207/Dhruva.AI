# ==============================================================================
# DHRUVA.AI — TEST ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
ENVIRONMENT=test
DEBUG=true
PROJECT_NAME="Dhruva.AI Test Suite"
API_V1_PREFIX=/api/v1
LOG_LEVEL=WARNING

SECRET_KEY=dhruva_unit_test_deterministic_secret_key_32_characters_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=1
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=1

COOKIE_NAME_REFRESH_TOKEN=dhruva_test_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

DATABASE_URL=sqlite+aiosqlite:///:memory:
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10

REDIS_URL=redis://localhost:6379/15
REDIS_ENABLED=false
REDIS_TIMEOUT_SECONDS=1

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage/test_uploads

EMAIL_PROVIDER=development
EMAIL_FROM="Dhruva Test <test@dhruva.ai>"

GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=512
AI_REQUEST_TIMEOUT=5
AI_DAILY_USER_LIMIT=100
AI_DAILY_INSTITUTION_LIMIT=1000

CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

FEATURE_AI_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_BACKGROUND_WORKERS_ENABLED=false
FEATURE_PUBLIC_PORTFOLIOS_ENABLED=true
FEATURE_PLACEMENT_MODULE_ENABLED=true
FEATURE_ADVANCED_ANALYTICS_ENABLED=true
