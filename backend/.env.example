# Dhruva.AI Backend Environment Configuration
ENVIRONMENT=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME="Dhruva.AI API"

# Security (Change in production!)
SECRET_KEY=dhruva_dev_secret_key_must_be_changed_in_production_32char
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dhruva_admin
POSTGRES_PASSWORD=dhruva_secret_change_in_prod
POSTGRES_DB=dhruva_db
# Async connection URL used by SQLAlchemy
DATABASE_URL=postgresql+asyncpg://dhruva_admin:dhruva_secret_change_in_prod@localhost:5432/dhruva_db

# Database statement timeout & SSL mode
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SSL_MODE=prefer

# Coding Sandbox Integration
SANDBOX_API_URL=
SANDBOX_API_TOKEN=
SANDBOX_TIMEOUT_SECONDS=5

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Orchestration (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
