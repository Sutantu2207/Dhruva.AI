# ==============================================================================
# DHRUVA.AI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS: Copy to .env in production deployment. Never commit production secrets to Git.

# --- Application Runtime ---
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="Dhruva.AI Institutional Platform"
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Security & Cryptographic Tokens ---
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_STRONG_UNPREDICTABLE_HEX_SECRET_MINIMUM_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# --- Brute Force & Rate Limiting ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Secure Cookie Configuration ---
COOKIE_NAME_REFRESH_TOKEN=dhruva_refresh_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.dhruva.edu.in

# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql+asyncpg://dhruva_prod_user:CHANGE_ME_STRONG_DB_PW@db.internal:5432/dhruva_production_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30

# --- Distributed Coordination & Caching (Redis) ---
REDIS_URL=redis://redis.internal:6379/0
REDIS_ENABLED=true
REDIS_TIMEOUT_SECONDS=2

# --- Object Storage (AWS S3 or MinIO S3-Compatible) ---
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
S3_BUCKET_NAME=dhruva-production-evidence-vault
S3_ACCESS_KEY_ID=AKIA_PRODUCTION_KEY_ID
S3_SECRET_ACCESS_KEY=PRODUCTION_SECRET_ACCESS_KEY
S3_REGION=ap-south-1

# --- Transactional Email ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.PRODUCTION_SENDGRID_KEY_CHANGE_ME
EMAIL_FROM="Dhruva Academic Office <noreply@dhruva.edu.in>"

# --- AI Orchestration (Google Gemini Vertex / API) ---
GEMINI_API_KEY=AIzaSy_PRODUCTION_GEMINI_KEY_CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
AI_REQUEST_TIMEOUT=30
AI_DAILY_USER_LIMIT=100
AI_DAILY_INSTITUTION_LIMIT=10000

# --- Web & CORS ---
CORS_ORIGINS=["https://app.dhruva.edu.in","https://admin.dhruva.edu.in"]
FRONTEND_URL=https://app.dhruva.edu.in

# --- Server-Authoritative Feature Flags ---
FEATURE_AI_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_BACKGROUND_WORKERS_ENABLED=true
FEATURE_PUBLIC_PORTFOLIOS_ENABLED=true
FEATURE_PLACEMENT_MODULE_ENABLED=true
FEATURE_ADVANCED_ANALYTICS_ENABLED=true

# --- Observability (Sentry / APM) ---
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
