# ==============================================================================
# DHRUVA.AI — CANONICAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Variable Classification Legend:
#   [REQUIRED]            - Must be set in all environments (development, test, staging, production).
#   [PRODUCTION REQUIRED] - Mandatory in staging and production; fallback disallowed.
#   [DEVELOPMENT ONLY]    - Permitted only during local offline development.
#   [OPTIONAL]            - Has safe, deterministic default if unset.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
# [REQUIRED] Active environment mode: 'development' | 'test' | 'staging' | 'production'
ENVIRONMENT=development
APPLICATION_ENV=development

# [REQUIRED] Disable debug mode in production to prevent stack trace leaks
# Values: 'true' (dev) | 'false' (staging/prod)
DEBUG=false

# [OPTIONAL] Application metadata
PROJECT_NAME="Dhruva.AI Educational Intelligence Platform"
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECRETS & AUTHENTICATION
# ------------------------------------------------------------------------------
# [PRODUCTION REQUIRED] Minimum 32-character high-entropy secret.
# In production, startup immediately aborts if set to a default or weak key.
# Generate with: openssl rand -hex 32
SECRET_KEY=dhruva_development_fallback_secret_must_change_in_production_min32char

# [OPTIONAL] Token signature algorithm (default: HS256)
ALGORITHM=HS256

# [OPTIONAL] Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# [OPTIONAL] Rate limiting and brute-force lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# [PRODUCTION REQUIRED] Secure Cookie Controls
COOKIE_NAME_REFRESH_TOKEN=dhruva_refresh_token
# Must be true in production to ensure cookies only transmit over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL 16 + PGVECTOR)
# ------------------------------------------------------------------------------
# [PRODUCTION REQUIRED] Async connection string to PostgreSQL 16
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://dhruva_admin:dhruva_secret_change_in_prod@localhost:5432/dhruva_db

# [OPTIONAL] Connection pooling & resilience parameters
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SSL_MODE=prefer

# ------------------------------------------------------------------------------
# 4. REDIS (DISTRIBUTED CACHING, RATE LIMITING, WORKER COORDINATION)
# ------------------------------------------------------------------------------
# [PRODUCTION REQUIRED] Redis connection string
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
REDIS_TIMEOUT_SECONDS=2
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. CODING SANDBOX EXECUTION CLUSTER
# ------------------------------------------------------------------------------
# [PRODUCTION REQUIRED for Coding Assessments]
# External isolated container execution runner (Docker/gVisor/Firecracker).
# If unconfigured, coding evaluations safely return 'REQUIRES_SANDBOX' without faking results.
SANDBOX_API_URL=http://localhost:8080
SANDBOX_API_TOKEN=
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_MAX_OUTPUT_BYTES=65536

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (AWS S3, CLOUDFLARE R2, MINIO, LOCAL)
# ------------------------------------------------------------------------------
# [REQUIRED] Storage backend type: 'local' (dev) | 's3' (production/staging)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage/uploads

# [PRODUCTION REQUIRED if STORAGE_BACKEND=s3]
S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
S3_BUCKET_NAME=dhruva-institutional-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL & NOTIFICATIONS
# ------------------------------------------------------------------------------
# [REQUIRED] Email provider: 'development' (logs to console) | 'smtp' | 'ses'
EMAIL_PROVIDER=development

# [PRODUCTION REQUIRED if EMAIL_PROVIDER=smtp]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM="Dhruva.AI <noreply@dhruva.ai>"

# ------------------------------------------------------------------------------
# 8. AI ORCHESTRATION (GOOGLE GEMINI VERTEX / API)
# ------------------------------------------------------------------------------
# [PRODUCTION REQUIRED for AI features]
# Google Gemini API key. If absent, academic truth remains 100% operational,
# while AI endpoints report honest 'degraded' status. Never fakes AI output.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
AI_REQUEST_TIMEOUT=30
AI_DAILY_USER_LIMIT=100
AI_DAILY_INSTITUTION_LIMIT=10000

# ------------------------------------------------------------------------------
# 9. CORS & FRONTEND ROUTING
# ------------------------------------------------------------------------------
# [PRODUCTION REQUIRED] Allowed CORS origins (JSON array or comma-separated string)
# Wildcards ('*') are strictly prohibited with credentials.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 10. SERVER-AUTHORITATIVE FEATURE FLAGS
# ------------------------------------------------------------------------------
# [OPTIONAL] Platform module toggles
FEATURE_AI_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_BACKGROUND_WORKERS_ENABLED=true
FEATURE_PUBLIC_PORTFOLIOS_ENABLED=true
FEATURE_PLACEMENT_MODULE_ENABLED=true
FEATURE_ADVANCED_ANALYTICS_ENABLED=true

# ------------------------------------------------------------------------------
# 11. OBSERVABILITY & MONITORING
# ------------------------------------------------------------------------------
# [OPTIONAL] Sentry DSN for error telemetry
SENTRY_DSN=
